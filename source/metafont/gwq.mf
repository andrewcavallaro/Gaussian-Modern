% gwq.mf -- the letter Q of the Gaussian Modern METAFONT roman.
% Bowl as in Computer Modern; the tail follows the Goettingen type:
% a hairline entering at the foot of the bowl, swelling into a short
% heavy sweep that ends just right of the bowl, a little below the baseline.
% Tail geometry is set by the parameters q_tail_* (fractions of w, h, d).

cmchar "The letter Q";
beginchar("Q",14u#-width_adj#,cap_height#,q_tail_depth*comma_depth#);
italcorr .7cap_height#*slant-.5u#;
adjust_fit(0,0);
numeric light_curve; light_curve=cap_curve-hround stem_corr;
penpos1(vair',90); penpos3(vair',-90);
penpos2(light_curve,180); penpos4(light_curve,0);
x2r=hround u; x4r=w-x2r; x1=x3=.5w; y1r=h+o; y2=y4=.5h-vair_corr; y3r=-o;
penstroke pulled_super_arc.e(1,2)(.5superpull)
 & pulled_super_arc.e(2,3)(.5superpull)
 & pulled_super_arc.e(3,4)(.5superpull)
 & pulled_super_arc.e(4,1)(.5superpull) & cycle;  % bowl
pickup tiny.nib;
penpos5(hair,q_tail_in_angle);                 % hairline entry, inside the bowl
penpos6(q_tail_weight*cap_curve,q_tail_mid_angle);  % heaviest part of the sweep
penpos7(.6q_tail_weight*cap_curve,q_tail_end_angle); % blunt end
x5=q_tail_x5*w; y5=q_tail_y5*h;
x6=q_tail_x6*w; y6=-.35d;
x7=q_tail_x7*w; bot y7l=-d;
filldraw stroke z5e{dir q_tail_dir5}..z6e{right}..{dir q_tail_dir7}z7e;  % tail
math_fit(-.3cap_height#*slant-.5u#,ic#);
penlabels(1,2,3,4,5,6,7); endchar;
