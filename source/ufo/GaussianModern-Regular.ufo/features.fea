languagesystem DFLT dflt;
languagesystem latn dflt;
feature liga {
  sub f f i by ffi;
  sub f f l by ffl;
  sub f f by ff;
  sub f i by fi;
  sub f l by fl;
} liga;
@AboveMarks = [uni0300 uni0301 uni0302 uni0303 uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];
feature ccmp { sub i' @AboveMarks by dotlessi; } ccmp;
